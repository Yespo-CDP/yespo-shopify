// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id                          Int       @id @default(autoincrement())
  shopId                      String    @unique
  shopUrl                     String    @unique
  email                       String
  name                        String
  domain                      String    @unique @default("")
  apiKey                      String?
  orgId                       Int?
  siteId                      String?
  defaultCurrency             String?
  defaultLanguageCode         String?
  syncedLocales               String[]
  isWebTrackingEnabled        Boolean?  @default(false)
  isContactSyncEnabled        Boolean?  @default(false)
  isOrderSyncEnabled          Boolean?  @default(false)
  isProductVariantSyncEnabled Boolean?  @default(false)
  isMarketSyncEnabled         Boolean?  @default(false)
  isAppInboxEnabled           Boolean?  @default(false)
  active                      Boolean?  @default(true)
  isGeneralScriptInstalled    Boolean?  @default(false)
  isWebPushScriptInstalled    Boolean?  @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime? @updatedAt

  customerDataRequests GdprCustomerDataRequest[]
  eventsData           EventData[]
  customerSyncs        CustomerSync[]
  customerSyncLogs     CustomerSyncLog?
  orderSyncs           OrderSync[]
  orderSyncLogs        OrderSyncLog?
  productVariantSyncs    ProductVariantSync[]
  productVariantSyncLogs ProductVariantSyncLog?
  shopMarkets            ShopMarket[]
  marketSyncs            MarketSync[]
  marketSyncLogs         MarketSyncLog[]
  tmpMarketSyncs         TmpMarketSync[]
}

model ShopMarket {
  id        Int      @id @default(autoincrement())
  marketId  String
  name      String
  handle    String
  enabled   Boolean  @default(true)
  countries String[]
  locales   String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int

  @@unique([shopId, marketId])
  @@index([shopId])
}

model GdprCustomerDataRequest {
  id        Int       @id @default(autoincrement())
  webhookId String    @unique
  topic     String
  payload   Json
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int
}

model EventData {
  cartToken String    @id
  sc        String
  ttl       DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int

  customer   Customer? @relation(fields: [customerId], references: [customerId])
  customerId String? // optional foreign key field
}

model Customer {
  customerId String  @id
  phone      String?
  email      String?
  firstName  String?
  lastName   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  eventsData EventData[]
}

model CustomerSync {
  id         Int       @id @default(autoincrement())
  customerId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int
}

enum SyncLogStatus {
  NOT_STARTED
  IN_PROGRESS
  ERROR
  COMPLETE
}

model CustomerSyncLog {
  id           Int           @id @default(autoincrement())
  syncedCount  Int           @default(0)
  skippedCount Int           @default(0)
  failedCount  Int           @default(0)
  totalCount   Int           @default(0)
  status       SyncLogStatus @default(NOT_STARTED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int  @unique
}

model OrderSyncLog {
  id           Int           @id @default(autoincrement())
  syncedCount  Int           @default(0)
  skippedCount Int           @default(0)
  failedCount  Int           @default(0)
  totalCount   Int           @default(0)
  status       SyncLogStatus @default(NOT_STARTED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int  @unique
}

model OrderSync {
  id        Int       @id @default(autoincrement())
  orderId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int
}

model ProductVariantSyncLog {
  id           Int           @id @default(autoincrement())
  syncedCount  Int           @default(0)
  skippedCount Int           @default(0)
  failedCount  Int           @default(0)
  totalCount   Int           @default(0)
  status       SyncLogStatus @default(NOT_STARTED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int  @unique
}

model ProductVariantSync {
  id             Int       @id @default(autoincrement())
  variantId      String
  productId      String
  syncedTagKeys  String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int
}

model MarketSyncLog {
  id           Int           @id @default(autoincrement())
  countryCode  String
  syncedCount  Int           @default(0)
  skippedCount Int           @default(0)
  failedCount  Int           @default(0)
  totalCount   Int           @default(0)
  status       SyncLogStatus @default(NOT_STARTED)
  bulkBatchId  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int

  @@unique([shopId, countryCode])
  @@index([shopId])
}

model MarketSync {
  id          Int       @id @default(autoincrement())
  productId   String
  variantId   String
  countryCode String
  contentHash String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int

  @@unique([shopId, productId, variantId, countryCode])
  @@index([shopId, variantId])
}

model TmpMarketSync {
  id          Int      @id @default(autoincrement())
  batchId     String
  productId   String
  variantId   String?
  countryCode String?
  locale      String?
  marketId    String?
  payload     Json
  createdAt   DateTime @default(now())

  shop   Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopId Int

  @@index([shopId, batchId])
}
