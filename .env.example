SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-domain.com
SHOPIFY_YESPO_EXTENSION_ID=
DATABASE_URL=postgresql://admin:admin@localhost:5432/yespoapp
SCOPES=read_all_orders,read_customers,read_orders,read_products,read_themes,write_app_proxy,write_products,read_translations,read_locales,read_publications,read_markets,unauthenticated_read_product_listings
API_URL=https://yespo.io/api/v1
GENERAL_SCRIPT_HANDLE=yespo-script
WEB_PUSH_SCRIPT_HANDLE=yespo-web-push-script
DOCK_URL=https://docs.yespo.io
PLATFORM_URL=https://my.yespo.io
REDIS_URL=redis://localhost:6379
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_KEY=

# Yespo App Inbox API base URL; the code appends /auth/contact/token. Production value required.
ESPUTNIK_URL=
WEB_TRACKER_URL=https://tracker.yespo.io/api/v2
# Remote log endpoint. Production value required.
LOGGING_URL=
CATEGORY_TYPE_HANDLE=yespo_category_type
HOST_URL=yespo-app-host
MARKET_TRACKING_ENABLED=market-tracking-enabled
WEB_PUSH_MULTI_DOMAIN_HANDLE=yespo-web-push-multi-domain
WEB_TRACKING_ENABLED=web-tracking-enabled
SERVICE_WORKER_NAME=service-worker.js
SERVICE_WORKER_PATH=/apps/yespo-proxy/
# Optional: custom shop domain passed to customShopDomains
SHOP_CUSTOM_DOMAIN=
